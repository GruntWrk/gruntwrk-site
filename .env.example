# Primary Google tag destination. In most setups this will be your GA4 Google tag / measurement ID.
NEXT_PUBLIC_GOOGLE_TAG_ID=G-XXXXXXXXXX

# Optional extra destinations if you want the same Google tag to feed multiple Google products directly.
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX

# Optional direct Google Ads conversion actions for CTA clicks.
# Format: AW-XXXXXXXXXX/label
# NEXT_PUBLIC_GOOGLE_ADS_CUSTOMER_REQUEST_SEND_TO=AW-XXXXXXXXXX/xxxxxxxxxxxx
# NEXT_PUBLIC_GOOGLE_ADS_PROVIDER_SIGNUP_SEND_TO=AW-XXXXXXXXXX/yyyyyyyyyyyy
